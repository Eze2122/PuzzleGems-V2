{
  "expo": {
    "name": "Puzzle Gems",
    "slug": "puzzle-gems-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jewel-sort-puzzle",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.puzzlegems.ozxnol",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Used to show you more relevant ads."
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#9B5CF6"
      },
      "package": "com.emergent.puzzlegems.ozxnol"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#8A7CF3"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7902708143841298~6437913199",
          "iosAppId": "ca-app-pub-3940256099942544~1458009866",
          "userTrackingUsageDescription": "Used to show you more relevant ads."
        }
      ],
      "@react-native-vector-icons/ionicons"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "eas": {
        "projectId": "1afac79e-7468-4ce2-be1d-67f19f122fc3"
      }
    }
  },

  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7902708143841298~6437913199",
    "ios_app_id": "ca-app-pub-3940256099942544~1458009866",
    "delay_app_measurement_init": false,
    "optimize_initialization": true,
    "optimize_ad_loading": true
  }
}
